# ==============================================================================
# Backend Spring Boot Environment Configuration Template
# Copy this file to '.env' and adjust the variables for your environment
# ==============================================================================

# Server Port (Render uses PORT, local can use SERVER_PORT or PORT)
PORT=8080
SERVER_PORT=8080

# CORS Allowed Origins (Comma-separated origins for production frontend e.g. https://your-frontend.onrender.com)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://your-frontend.onrender.com

# MySQL Database Configuration
DB_URL=jdbc:mysql://localhost:3306/clothing_store?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT Security Configuration
# JWT_ACCESS_SECRET must be at least 32 characters (256 bits) for HMAC-SHA256 / SHA384
JWT_ACCESS_SECRET=your-super-secure-secret-key-at-least-32-characters-long
JWT_ACCESS_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=2592000000

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
