# ==============================================================================
# Backend .gitignore
# ==============================================================================

# Build target and artifacts
target/
build/
*.class
*.jar
*.war
*.ear
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
!**/src/main/**/build/
!**/src/test/**/build/

# Environment files and credentials (CRITICAL: DO NOT COMMIT)
.env
.env.*
!.env.example
*.local

# Logs
logs/
*.log

# IDE & Editor files
### IntelliJ IDEA ###
.idea/
*.iws
*.iml
*.ipr
out/

### Eclipse / STS ###
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

### NetBeans ###
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

### VS Code ###
.vscode/

### OS Files ###
.DS_Store
Thumbs.db
desktop.ini
HELP.md
