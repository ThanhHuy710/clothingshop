# ==============================================================================
# WebMayMac - Full Project Environment Variables Overview
# ==============================================================================
# This file provides a centralized overview of environment variables used across
# the project. Copy variables to their respective .env files before running:
# - Frontend: copy to 'frontend/.env'
# - Backend:  copy to 'backend/.env'
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Configuration (see frontend/.env.example)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8080/api

# ------------------------------------------------------------------------------
# Backend Configuration (see backend/.env.example)
# ------------------------------------------------------------------------------
SERVER_PORT=8080

# MySQL Database
DB_URL=jdbc:mysql://localhost:3306/clothing_store?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT Security
JWT_ACCESS_SECRET=your-super-secure-secret-key-at-least-32-characters-long
JWT_ACCESS_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=2592000000

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
