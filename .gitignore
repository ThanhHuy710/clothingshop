# ==============================================================================
# Global / Root .gitignore for WebMayMac Project
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secret Files (CRITICAL: DO NOT COMMIT)
# ------------------------------------------------------------------------------
*.env
*.env.*
!.env.example
!.env.*.example
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
*.key
*.pem
*.cert
*.pfx
*.p12

# ------------------------------------------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
.pnp
.pnp.js

# ------------------------------------------------------------------------------
# Build Outputs & Compiled Binaries
# ------------------------------------------------------------------------------
# Frontend
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/
*.local

# Backend Java / Maven
target/
**/target/
backend/target/
build/
**/build/
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# ------------------------------------------------------------------------------
# Logs & Temporary Files
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
tmp/
temp/
*.tmp
*.temp
*screenshot*.png

# ------------------------------------------------------------------------------
# IDE & Editor Configurations
# ------------------------------------------------------------------------------
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code
.vscode/
!.vscode/extensions.json

# Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/

# Sublime / Vim
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# Database Dumps (Backups with sensitive production credentials)
# ------------------------------------------------------------------------------
*.dump
*.backup
*.sql.gz
*.sqlite
*.db
