# ==============================================================================
# Frontend .gitignore
# ==============================================================================

# Dependencies
node_modules/

# Production build output
dist/
dist-ssr/

# Environment files and credentials (CRITICAL: DO NOT COMMIT)
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
